DASHBOARD_BASE_URL=http://localhost:89
DASHBOARD_TOKEN=
DASHBOARD_AUTH_PROVIDER=MICROSOFT

# stdio (local Cursor/Desktop) | http (Coolify Streamable HTTP)
MCP_TRANSPORT=stdio

# HTTP / Coolify only
HOST=0.0.0.0
PORT=3000
# Required when MCP_TRANSPORT=http — Claude Desktop / client sends: Authorization: Bearer <this>
MCP_AUTH_TOKEN=
