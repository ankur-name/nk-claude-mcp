DASHBOARD_BASE_URL=http://localhost:89
# Same value as Dashboard CLAUDE_MCP_INTERNAL_SERVICE_KEY / claude.mcp.internal-service-key
DASHBOARD_INTERNAL_KEY=

# stdio (local Cursor/Desktop) | http (Coolify Streamable HTTP)
MCP_TRANSPORT=stdio

# HTTP / Coolify only
HOST=0.0.0.0
PORT=3000
# Required when MCP_TRANSPORT=http — Claude Desktop / client sends: Authorization: Bearer <this>
MCP_AUTH_TOKEN=
